{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do \u00f3rg\u00e3o p\u00fablico ou conta"
    },
    "type": {
      "type": "string",
      "enum": [
        "prefeitura",
        "secretaria",
        "autarquia",
        "fundacao",
        "empresa_publica",
        "outros"
      ],
      "description": "Tipo de organiza\u00e7\u00e3o"
    },
    "state": {
      "type": "string",
      "description": "UF (2 caracteres)"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "region": {
      "type": "string",
      "enum": [
        "norte",
        "nordeste",
        "centro_oeste",
        "sudeste",
        "sul"
      ],
      "description": "Regi\u00e3o do Brasil"
    },
    "website": {
      "type": "string",
      "description": "Website da organiza\u00e7\u00e3o"
    },
    "phone": {
      "type": "string",
      "description": "Telefone principal"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Organiza\u00e7\u00e3o ativa"
    },
    "owner_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela conta"
    }
  },
  "required": [
    "name"
  ]
}