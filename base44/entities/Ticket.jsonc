{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do ticket"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do problema/solicita\u00e7\u00e3o"
    },
    "organization_id": {
      "type": "string",
      "description": "ID da organiza\u00e7\u00e3o"
    },
    "contact_id": {
      "type": "string",
      "description": "ID do contato"
    },
    "assigned_to": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel"
    },
    "type": {
      "type": "string",
      "enum": [
        "suporte_tecnico",
        "duvida_funcional",
        "melhoria",
        "incidente"
      ],
      "description": "Tipo do ticket"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_andamento",
        "aguardando_cliente",
        "resolvido",
        "arquivado"
      ],
      "default": "aberto",
      "description": "Status do ticket"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media",
      "description": "Prioridade"
    },
    "module_related": {
      "type": "string",
      "description": "Sistema/m\u00f3dulo relacionado"
    },
    "sla_hours": {
      "type": "number",
      "description": "SLA em horas"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da resolu\u00e7\u00e3o"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de URLs de arquivos anexados"
    }
  },
  "required": [
    "title",
    "description"
  ]
}