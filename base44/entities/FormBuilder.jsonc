{
  "name": "FormBuilder",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do formul\u00e1rio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do formul\u00e1rio"
    },
    "slug": {
      "type": "string",
      "description": "Slug \u00fanico para URL p\u00fablica"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativo",
        "encerrado"
      ],
      "default": "rascunho",
      "description": "Status do formul\u00e1rio"
    },
    "fields": {
      "type": "array",
      "description": "Array de campos do formul\u00e1rio",
      "items": {
        "type": "object"
      }
    },
    "landing_page": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o visual da landing page"
    },
    "submissions_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de submiss\u00f5es"
    }
  },
  "required": [
    "title"
  ]
}