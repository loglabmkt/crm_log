{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da oportunidade"
    },
    "organization_id": {
      "type": "string",
      "description": "ID da organiza\u00e7\u00e3o"
    },
    "contact_id": {
      "type": "string",
      "description": "ID do contato principal"
    },
    "owner_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel"
    },
    "stage": {
      "type": "string",
      "enum": [
        "prospeccao",
        "qualificacao",
        "proposta",
        "negociacao",
        "licitacao",
        "fechado_ganho",
        "fechado_perdido"
      ],
      "default": "prospeccao",
      "description": "Est\u00e1gio do funil de vendas"
    },
    "estimated_value": {
      "type": "number",
      "description": "Valor estimado da oportunidade"
    },
    "probability": {
      "type": "number",
      "description": "Probabilidade de fechamento (0-100)"
    },
    "origin": {
      "type": "string",
      "enum": [
        "indicacao",
        "licitacao",
        "prospeccao_ativa",
        "evento",
        "campanha",
        "outros"
      ],
      "description": "Origem da oportunidade"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de fechamento"
    },
    "opened_at": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura"
    },
    "closed_at": {
      "type": "string",
      "format": "date",
      "description": "Data de fechamento efetivo"
    },
    "loss_reason": {
      "type": "string",
      "description": "Motivo da perda (quando fechado_perdido)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "title"
  ]
}