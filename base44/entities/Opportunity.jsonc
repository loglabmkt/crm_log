{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "nr": {
      "type": "number",
      "description": "N\u00famero sequencial da oportunidade"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo/descri\u00e7\u00e3o da oportunidade"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente/\u00f3rg\u00e3o em texto livre"
    },
    "organization_id": {
      "type": "string",
      "description": "ID da organiza\u00e7\u00e3o"
    },
    "contact_id": {
      "type": "string",
      "description": "ID do contato principal"
    },
    "owner_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel"
    },
    "stage": {
      "type": "string",
      "enum": [
        "prospeccao",
        "qualificacao",
        "proposta",
        "negociacao",
        "licitacao",
        "fechado_ganho",
        "fechado_perdido"
      ],
      "default": "prospeccao",
      "description": "Est\u00e1gio legado do funil de vendas"
    },
    "situacao": {
      "type": "string",
      "enum": [
        "em_andamento",
        "congelada",
        "desistida",
        "cancelada",
        "substituida",
        "vendida"
      ],
      "default": "em_andamento",
      "description": "Situa\u00e7\u00e3o atual da oportunidade"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "dimensionando",
        "elaborando_contrato",
        "elaborando_os",
        "executando",
        "obtendo_aprovacoes",
        "encerrado"
      ],
      "default": "dimensionando",
      "description": "Etapa do processo"
    },
    "funil": {
      "type": "string",
      "description": "Funil de origem (texto livre)"
    },
    "chance": {
      "type": "number",
      "description": "Chance de 1 a 5"
    },
    "parceiro": {
      "type": "string",
      "description": "Nome do parceiro (opcional)"
    },
    "tipo_negocio": {
      "type": "string",
      "description": "Tipo de neg\u00f3cio (ex: Ades\u00e3o a ATA, Contrato, OS)"
    },
    "ata_anotacoes": {
      "type": "string",
      "description": "Ata e anota\u00e7\u00f5es estruturais"
    },
    "nr_contrato_os": {
      "type": "string",
      "description": "N\u00famero do contrato ou OS"
    },
    "estimated_value": {
      "type": "number",
      "description": "Valor estimado da oportunidade"
    },
    "probability": {
      "type": "number",
      "description": "Probabilidade de fechamento (0-100)"
    },
    "origin": {
      "type": "string",
      "enum": [
        "indicacao",
        "licitacao",
        "prospeccao_ativa",
        "evento",
        "campanha",
        "outros"
      ],
      "description": "Origem da oportunidade"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de fechamento"
    },
    "opened_at": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura"
    },
    "closed_at": {
      "type": "string",
      "format": "date",
      "description": "Data de fechamento efetivo"
    },
    "loss_reason": {
      "type": "string",
      "description": "Motivo da perda"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "title"
  ]
}