{
  "name": "ContactPanel",
  "type": "object",
  "properties": {
    "pos_id_logistico": {
      "type": "string",
      "description": "ID log\u00edstico opcional (ex: POS-001)"
    },
    "municipio": {
      "type": "string",
      "description": "Nome do munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF com 2 caracteres"
    },
    "regiao": {
      "type": "string",
      "enum": [
        "norte",
        "nordeste",
        "centro_oeste",
        "sudeste",
        "sul"
      ],
      "description": "Regi\u00e3o do Brasil (preenchida automaticamente pelo UF)"
    },
    "populacao_estimada": {
      "type": "number",
      "description": "Popula\u00e7\u00e3o estimada do munic\u00edpio"
    },
    "orgao_secretaria": {
      "type": "string",
      "description": "\u00d3rg\u00e3o ou secretaria"
    },
    "nome_contato": {
      "type": "string",
      "description": "Nome do respons\u00e1vel pelo contato"
    },
    "email": {
      "type": "string",
      "description": "Email do contato"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead_email",
        "lead_telefone",
        "em_contato",
        "reuniao_agendada",
        "proposta_enviada",
        "cliente_ativo",
        "inativo"
      ],
      "default": "lead_email",
      "description": "Status do relacionamento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "municipio",
    "uf",
    "status"
  ]
}